<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="PetShelter.Uix.Views.AdoptionRequestsWindow"
		Width="700"
		Height="500"
		Title="Adoption Requests"
		Background="White"
		RequestedThemeVariant="Light">

	<Grid Background="White">
		<Border Margin="16" Padding="12" Background="#F7F7F7" CornerRadius="8" BorderBrush="#D9D9D9" BorderThickness="1">
			<StackPanel Spacing="10">
				<TextBlock Text="Pending Adoption Requests" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

				<ListBox Name="RequestsListBox" Height="320"/>

				<StackPanel Orientation="Horizontal" Spacing="8">
					<Button Content="Approve" Width="100" Click="ApproveButton_Click"/>
					<Button Content="Decline" Width="100" Click="DeclineButton_Click"/>
					<Button Content="Close" Width="90" Click="CloseButton_Click"/>
				</StackPanel>
			</StackPanel>
		</Border>
	</Grid>

</Window>
