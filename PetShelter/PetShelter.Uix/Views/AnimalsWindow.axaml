<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PetShelter.Uix.Views.AnimalsWindow"
        Width="1250"
        Height="700"
        MinWidth="950"
        MinHeight="500"
        Title="Animals"
        Background="White"
        RequestedThemeVariant="Light">

    <Window.Styles>

        <Style Selector="Button.action">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#BFBFBF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.action:pointerover">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#BFBFBF"/>
        </Style>

        <Style Selector="Button.action:pressed">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#BFBFBF"/>
        </Style>

    </Window.Styles>

    <Grid Margin="30"
          RowDefinitions="Auto,Auto,*,Auto">

        <StackPanel Grid.Row="0">

            <TextBlock Text="Animals"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="Black"/>

            <TextBlock Text="{Binding AssociationName}"
                       FontSize="16"
                       Foreground="#555555"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,20,0,15">

            <Button Classes="action"
                    Content="Add"
                    Click="AddButton_Click"/>

            <Button Classes="action"
                    Content="Edit"
                    Click="EditButton_Click"/>

            <Button Classes="action"
                    Content="Delete"
                    Click="DeleteButton_Click"/>

        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Background="White">

            <DataGrid ItemsSource="{Binding Animals}"
                      SelectedItem="{Binding SelectedAnimal}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Background="White"
                      Foreground="Black"
                      GridLinesVisibility="All">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Species"
                                        Binding="{Binding Species}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Breed"
                                        Binding="{Binding Breed}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Gender"
                                        Binding="{Binding Gender}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Date of birth"
                                        Binding="{Binding DateOfBirth}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Vaccinated"
                                        Binding="{Binding IsVaccinated}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Sterilized"
                                        Binding="{Binding IsSterilized}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Health"
                                        Binding="{Binding HealthStatus}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Arrival date"
                                        Binding="{Binding DateArrived}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Description"
                                        Binding="{Binding Description}"
                                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto"
              Margin="0,15,0,0">

            <TextBlock Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>

            <Button Grid.Column="1"
                    Classes="action"
                    Content="Back"
                    Click="BackButton_Click"/>

        </Grid>

    </Grid>

</Window>