<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PetShelter.Uix.Views.AssociationAdminWindow"
        Width="700"
        Height="600"
        Title="Association Administrator"
        Background="White">

    <Window.Styles>

        <Style Selector="Button.main">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#BFBFBF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.main:pointerover">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style Selector="Button.logout">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#BFBFBF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.logout:pointerover">
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

    </Window.Styles>

    <Grid Background="White">

        <Border Width="470"
                Padding="35"
                Background="#F7F7F7"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel Spacing="15">

                <TextBlock Text="{Binding AssociationName}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="Black"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <TextBlock Text="Association Administration"
                           FontSize="16"
                           Foreground="#555555"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <Button Classes="main"
                        Content="Volunteers"
                        Click="VolunteersButton_Click"/>

                <Button Classes="main"
                        Content="Animals"
                        Click="AnimalsButton_Click"/>

                <Button Classes="main"
                        Content="Adopters"
                        Click="AdoptersButton_Click"/>

                <Button Classes="main"
                        Content="Adoption Requests"
                        Click="AdoptionRequestsButton_Click"/>

                <Button Classes="main"
                        Content="Finances"
                        Click="FinancesButton_Click"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>

                <Button Classes="logout"
                        Content="Logout"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Click="LogoutButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>