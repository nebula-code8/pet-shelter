<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="PetShelter.Uix.Views.TemporaryAdoptionWindow"
		Width="600"
		Height="500"
		Title="Temporarily Adopt an Animal"
		Background="White"
		RequestedThemeVariant="Light">

	<Grid Background="White">
		<Border Margin="16" Padding="12" Background="#F7F7F7" CornerRadius="8" BorderBrush="#D9D9D9" BorderThickness="1">
			<StackPanel Spacing="10">
				<TextBlock Text="Select an animal to temporarily adopt" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>

				<ListBox Name="AnimalsListBox" Height="340"/>

				<StackPanel Orientation="Horizontal" Spacing="8">
					<Button Content="Confirm" Width="100" Click="ConfirmButton_Click"/>
					<Button Content="Cancel" Width="100" Click="CancelButton_Click"/>
				</StackPanel>
			</StackPanel>
		</Border>
	</Grid>

</Window>
