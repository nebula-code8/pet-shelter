<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PetShelter.Uix.Views.VolunteersWindow"
        Width="1150"
        Height="650"
        MinWidth="900"
        MinHeight="500"
        Title="Volunteers"
        Background="White">

    <Window.Styles>

        <Style Selector="Button.action">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#BFBFBF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style Selector="Button.action:pointerover">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#BFBFBF"/>
        </Style>

        <Style Selector="Button.action:pressed">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#BFBFBF"/>
        </Style>

    </Window.Styles>

    <Grid Margin="30"
          RowDefinitions="Auto,Auto,*,Auto">

        <StackPanel Grid.Row="0">

            <TextBlock Text="Volunteers"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="Black"/>

            <TextBlock Text="{Binding AssociationName}"
                       FontSize="16"
                       Foreground="#555555"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,20,0,15">

            <Button Classes="action"
                    Content="Approve"
                    Click="ApproveButton_Click"/>

            <Button Classes="action"
                    Content="Reject"
                    Click="RejectButton_Click"/>

        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Background="White">

            <DataGrid ItemsSource="{Binding Volunteers}"
                      SelectedItem="{Binding SelectedVolunteer}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Background="White"
                      Foreground="Black"
                      GridLinesVisibility="All">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="ID"
                        Binding="{Binding Id}"
                        Width="60"/>

                    <DataGridTextColumn
                        Header="Name"
                        Binding="{Binding Name}"
                        Width="120"/>

                    <DataGridTextColumn
                        Header="Surname"
                        Binding="{Binding Surname}"
                        Width="130"/>

                    <DataGridTextColumn
                        Header="Email"
                        Binding="{Binding EmailAddress}"
                        Width="220"/>

                    <DataGridTextColumn
                        Header="Phone"
                        Binding="{Binding PhoneNumber}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="Status"
                        Binding="{Binding Status}"
                        Width="110"/>

                    <DataGridTextColumn
                        Header="Comment"
                        Binding="{Binding VolunteerComment}"
                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto"
              Margin="0,15,0,0">

            <TextBlock Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>

            <Button Grid.Column="1"
                    Classes="action"
                    Content="Back"
                    Click="BackButton_Click"/>

        </Grid>

    </Grid>

</Window>